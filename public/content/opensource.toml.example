# Open Source Page Example
# Copy this file to opensource.toml (next to config.toml) and replace the entries.
# TOML format: https://toml.io/
#
# The /open-source page and the "Open source" link on the About page appear only
# while this file exists, parses, and lists at least one project or contribution.
# A parse error or an unknown key hides both and is logged by the server, so a
# typo never publishes a half-broken page.
#
# Cards render in the order they appear in this file.
#
# A card can show a screenshot (`image`, any URL or site path). A good home for
# one is the /readme/<repo>/ folder: files under README_ASSETS_DIR/<repo>/. The page
# adds the file's modification time to its address, so browsers keep the screenshot,
# and one replaced in place still shows up. /content/ works too, but browsers keep
# the old file for up to a year after you replace it.
#
# Set `image_invert = true` when the image is white line art on a transparent
# background, such as a terminal animation. The card then draws it inverted, black
# on the white page, and the full-screen viewer shows it as it is, white on its dark
# overlay. A normal screenshot would come out as its own negative.
#
# `image_card` is what the card shows on desktop instead of `image`; full screen
# and phones still use `image`. It lets the card's file be sized for the desktop
# slot (676x420: twice the 338x210 inside the card's 1px border) while full screen
# gets the full-size file. Set without `image`, it is the image, full screen too.
#
# This file is public: the content directory is served as-is under /content/, so
# anyone can download it, comments and commented-out entries included. Keep
# drafts and private notes out of it.

# Optional: a paragraph under the page heading.
intro = "Things I've built, and projects I've contributed to."

# Your own projects. Each [[projects]] block is one card.
[[projects]]
name = "portfolio"                                # required
url = "https://example.com/you/portfolio"        # optional; the name links here
website = "https://portfolio.example"            # optional; shown beside the name as its domain
summary = "This site: a photography portfolio."  # required
tags = ["Rust", "Leptos"]                        # optional
image = "/readme/portfolio/card.webp"            # optional; a screenshot right of the text
image_alt = "The portfolio home page"            # optional; defaults to "<name> screenshot"
image_invert = false                             # optional; see `image_invert` above
image_card = "/readme/portfolio/card-small.webp" # optional; what the card shows instead

[[projects]]
name = "another-project"
summary = "A card with no url renders its name as plain text."

# Upstream projects you've contributed to. Same fields as [[projects]].
[[contributions]]
name = "Some Upstream"
url = "https://example.com/upstream/some-upstream"
summary = "What you worked on there, in a sentence or two."
tags = ["C", "Vulkan"]

# Optional: links to notable pieces of work, shown under the card.
# Each highlight needs both a title and a url.
[[contributions.highlights]]
title = "#123 A notable change"
url = "https://example.com/upstream/some-upstream/pull/123"

[[contributions.highlights]]
title = "#456 Another one"
url = "https://example.com/upstream/some-upstream/pull/456"

[[contributions]]
name = "Another Upstream"
url = "https://example.com/upstream/another-upstream"
summary = "A contribution card without highlights."
